rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       AUTH HELPERS
    ========================= */

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/cafeUsers/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/cafeUsers/$(request.auth.uid)).data;
    }

    function isCafeUser(cafeId) {
      return hasUserDoc() &&
        getUserData().cafeId == cafeId;
    }

    function isOwner(cafeId) {
      return isCafeUser(cafeId) &&
        getUserData().role == "owner";
    }

    function isManager(cafeId) {
      return isCafeUser(cafeId) &&
        getUserData().role == "manager";
    }

    function isOwnerOrManager(cafeId) {
      return isOwner(cafeId) || isManager(cafeId);
    }

    function canReadCafeScopedResource() {
      return isAuthenticated() &&
        resource.data.cafeId is string &&
        isOwnerOrManager(resource.data.cafeId);
    }

    function canCreateCafeScopedResource() {
      return isAuthenticated() &&
        request.resource.data.cafeId is string &&
        isOwnerOrManager(request.resource.data.cafeId);
    }

    function canUpdateCafeScopedResource() {
      return canReadCafeScopedResource() &&
        request.resource.data.cafeId == resource.data.cafeId;
    }

    /* =========================
       CAFES
    ========================= */

    match /cafes/{cafeId} {
      allow read: if isOwnerOrManager(cafeId);
      allow create: if false;
      allow update, delete: if isOwner(cafeId);
    }

    /* =========================
       USERS
    ========================= */

    match /cafeUsers/{userId} {
      allow get: if isAuthenticated() &&
        request.auth.uid == userId;

      allow list: if false;
      allow create, update, delete: if false;
    }

    /* =========================
       TABLES
    ========================= */

    match /tables/{tableId} {

      allow read: if canReadCafeScopedResource();

      allow create: if canCreateCafeScopedResource();

      allow update: if canUpdateCafeScopedResource();

      allow delete: if canReadCafeScopedResource();
    }

    /* =========================
       TABLE ITEMS
    ========================= */

    match /tableItems/{itemId} {

      allow read: if canReadCafeScopedResource();

      allow create: if canCreateCafeScopedResource();

      allow update: if canUpdateCafeScopedResource();

      /* KRİTİK FIX */
      allow delete: if canReadCafeScopedResource();
    }

    /* =========================
       ACTIVITY LOGS
    ========================= */

    match /tableActivityLogs/{logId} {

      allow read: if isAuthenticated()
        && resource.data.cafeId is string
        && isOwnerOrManager(resource.data.cafeId);

      allow create: if canCreateCafeScopedResource();

      allow update, delete: if false;
    }

    /* =========================
       PUBLIC TABLES
    ========================= */

    match /publicTables/{token} {

      allow read: if resource.data.deletedAt == null;

      allow create: if canCreateCafeScopedResource();
      allow update: if canUpdateCafeScopedResource();
      allow delete: if canReadCafeScopedResource();
    }

    /* =========================
       COMPLETED SESSIONS
    ========================= */

    match /completedSessions/{sessionId} {

      allow read: if canReadCafeScopedResource();

      allow create: if canCreateCafeScopedResource();

      allow update: if canUpdateCafeScopedResource();
      allow delete: if canReadCafeScopedResource();
    }

    /* =========================
       SALES LOGS
    ========================= */

    match /salesLogs/{saleId} {
      allow read: if canReadCafeScopedResource();

      allow create: if canCreateCafeScopedResource();

      allow update, delete: if false;
    }

    match /cafes/{cafeId}/salesLogs/{saleId} {
      allow read, create: if isOwnerOrManager(cafeId);
      allow update, delete: if false;
    }

    match /cafes/{cafeId}/dailyReports/{dayKey} {
      allow read, create, update: if isOwnerOrManager(cafeId);
      allow delete: if false;
    }

    match /cafes/{cafeId}/productEvents/{eventId} {
      allow read, create: if isOwnerOrManager(cafeId);
      allow update, delete: if false;
    }

    /* =========================
       PAYMENTS
    ========================= */

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    /* =========================
       FALLBACK
    ========================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
